{
  "name": "angels-170",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable",
    "package:mac": "npm run build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "test": "node --test tests/*.test.js",
    "test:desktop": "node scripts/smoke-desktop.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "lucide-react": "^0.468.0",
    "matter-js": "^0.20.0",
    "metal-fx": "^2.0.10",
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.angel.lsat",
    "productName": "Angels 170",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": "-",
      "notarize": false,
      "artifactName": "Angels-170-${version}-${arch}.${ext}",
      "icon": "build/icon.png",
      "minimumSystemVersion": "13.0"
    }
  },
  "description": "An elegant personal LSAT study sanctuary for Angel Thukral",
  "author": "Angels 170"
}
